# Server
PORT=3000
NODE_ENV=production

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=1d

# Session (used for flash messages)
SESSION_SECRET=change_this_session_secret_too

# Default Super Admin (only used the first time DB is initialized)
DEFAULT_ADMIN_USERNAME=superadmin
DEFAULT_ADMIN_PASSWORD=aura@1234

# Vehicle Info API (upstream provider this panel proxies to)
VEHICLE_API_BASE_URL=https://vehicleinfo.noobgamingv40.workers.dev/fetch?vehicle=

# SQLite DB file path
DB_PATH=./data/database.sqlite

# Default limits applied to newly generated API keys unless overridden
DEFAULT_DAILY_LIMIT=100
DEFAULT_TOTAL_LIMIT=10000
DEFAULT_EXPIRY_DAYS=30
